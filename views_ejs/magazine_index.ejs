<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--bg-card); color: var(--text-primary); border-left: 4px solid var(--btn-primary-bg) !important;">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1">Magazines Section</h2>
        <p class="text-muted small mb-0">Weekly, fortnightly &amp; monthly magazine subscriptions with prices in ₹ (INR).</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('magazinesTable', 'magazines_catalog.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Magazine/Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-circle me-1"></i> Register New Magazine
        </a>
    </div>
</div>

<!-- GENRE FILTER TABS & SEARCH BAR -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-12 col-md-8">
        <div class="filter-tab-bar d-flex flex-wrap gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab active" onclick="filterMagazines('all', this)">All Genres</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Current', this)">Current Affairs</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Business', this)">Business &amp; Wealth</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Science', this)">Science &amp; Nature</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Politics', this)">Politics &amp; Culture</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Weekly', this)">Weekly</button>
            <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterMagazines('Monthly', this)">Monthly</button>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <form method="get" action="/Magazine/Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-card border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchQuery" value="<%= searchQuery %>" class="form-control border-start-0 py-2" placeholder="Search title, publisher, genre..." />
            </div>
            <button type="submit" class="btn btn-primary-custom">Search</button>
            <% if (searchQuery) { %>
                <a href="/Magazine/Index" class="btn btn-secondary-custom d-flex align-items-center">Clear</a>
            <% } %>
        </form>
    </div>
</div>

<div class="custom-table-container">
    <table class="custom-table" id="magazinesTable">
        <thead>
            <tr>
                <th>Title</th>
                <th>Publisher</th>
                <th>Issue Number</th>
                <th>Genre</th>
                <th>Frequency</th>
                <th>Price (₹)</th>
                <th>Publish Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (magazines.length > 0) { %>
                <% magazines.forEach(function(item) { %>
                    <tr>
                        <td>
                            <div class="fw-bold"><%= item.title %></div>
                        </td>
                        <td>
                            <span><%= item.publisher %></span>
                        </td>
                        <td>
                            <code class="px-2.5 py-1 rounded font-monospace text-nowrap"><%= item.issueNumber %></code>
                        </td>
                        <td>
                            <span class="text-secondary small"><%= item.genre %></span>
                        </td>
                        <td>
                            <span class="subtle-text-badge"><%= item.frequency %></span>
                        </td>
                        <td>
                            <span class="price-tag">₹<%= item.price %></span>
                        </td>
                        <td>
                            <span class="text-muted small"><%= item.publishDate %></span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm gap-1">
                                <a href="/Magazine/Edit/<%= item.magazineId %>" class="btn btn-sm btn-blue-edit">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>
                                <a href="/Magazine/Delete/<%= item.magazineId %>" class="btn btn-sm btn-blue-delete" onclick="return confirm('Are you sure you want to delete this magazine?')">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="8" class="text-center text-muted">No magazine records found matching the criteria.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Pagination Controls -->
<% if (totalPages > 1) { %>
    <nav aria-label="Magazine navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/Magazine/Index?searchQuery=<%= searchQuery %>&page=<%= currentPage - 1 %>">Previous</a>
            </li>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="/Magazine/Index?searchQuery=<%= searchQuery %>&page=<%= i %>"><%= i %></a>
                </li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/Magazine/Index?searchQuery=<%= searchQuery %>&page=<%= currentPage + 1 %>">Next</a>
            </li>
        </ul>
    </nav>
<% } %>

<script>
    function filterMagazines(genre, btn) {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        const rows = document.querySelectorAll('#magazinesTable tbody tr');
        rows.forEach(row => {
            const genreCell = row.cells[3] ? row.cells[3].textContent.toLowerCase() : '';
            const freqCell = row.cells[4] ? row.cells[4].textContent.toLowerCase() : '';
            const term = genre.toLowerCase();
            if (genre === 'all' || genreCell.includes(term) || freqCell.includes(term)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>

<%- include('footer') %>
