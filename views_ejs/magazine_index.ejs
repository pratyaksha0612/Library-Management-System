<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-custom-blue alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1">Magazines Section</h2>
        <p class="text-muted small mb-0">Weekly, fortnightly &amp; monthly magazine subscriptions with prices in ₹ (INR).</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('magazinesTable', 'magazines_catalog.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Magazine/Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-circle me-1"></i> Register New Magazine
        </a>
    </div>
</div>

<!-- GENRE FILTER TABS -->
<div class="mb-4">
    <div class="filter-tab-bar">
        <button class="filter-tab active" onclick="filterMagazines('all', this)">All Genres</button>
        <button class="filter-tab" onclick="filterMagazines('Current', this)">Current Affairs</button>
        <button class="filter-tab" onclick="filterMagazines('Business', this)">Business &amp; Wealth</button>
        <button class="filter-tab" onclick="filterMagazines('Science', this)">Science &amp; Nature</button>
        <button class="filter-tab" onclick="filterMagazines('Politics', this)">Politics &amp; Culture</button>
        <button class="filter-tab" onclick="filterMagazines('Weekly', this)">Weekly</button>
        <button class="filter-tab" onclick="filterMagazines('Monthly', this)">Monthly</button>
    </div>
</div>

<div class="custom-table-container">
    <table class="custom-table" id="magazinesTable">
        <thead>
            <tr>
                <th>Title</th>
                <th>Publisher</th>
                <th>Issue Number</th>
                <th>Genre</th>
                <th>Frequency</th>
                <th>Price (₹)</th>
                <th>Publish Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% magazines.forEach(function(item) { %>
                <tr>
                    <td>
                        <div class="fw-bold"><%= item.title %></div>
                    </td>
                    <td>
                        <span><%= item.publisher %></span>
                    </td>
                    <td>
                        <code class="px-2.5 py-1 rounded font-monospace text-nowrap"><%= item.issueNumber %></code>
                    </td>
                    <td>
                        <span class="text-secondary small"><%= item.genre %></span>
                    </td>
                    <td>
                        <span class="subtle-text-badge"><%= item.frequency %></span>
                    </td>
                    <td>
                        <span class="price-tag">₹<%= item.price %></span>
                    </td>
                    <td>
                        <span class="text-muted small"><%= item.publishDate %></span>
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm gap-1">
                            <a href="/Magazine/Edit/<%= item.magazineId %>" class="btn btn-sm btn-blue-edit">
                                <i class="bi bi-pencil-fill"></i> Edit
                            </a>
                            <a href="/Magazine/Delete/<%= item.magazineId %>" class="btn btn-sm btn-blue-delete" onclick="return confirm('Are you sure you want to delete this magazine?')">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

<script>
    function filterMagazines(genre, btn) {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        const rows = document.querySelectorAll('#magazinesTable tbody tr');
        rows.forEach(row => {
            const genreCell = row.cells[3] ? row.cells[3].textContent.toLowerCase() : '';
            const freqCell = row.cells[4] ? row.cells[4].textContent.toLowerCase() : '';
            const term = genre.toLowerCase();
            if (genre === 'all' || genreCell.includes(term) || freqCell.includes(term)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>

<%- include('footer') %>
