<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kitaab Library</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Init theme prior to rendering body to prevent flash
        const savedTheme = localStorage.getItem('lms_theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom py-1 shadow" style="background: #032014 !important;">
            <div class="container-fluid px-4">
                <a class="navbar-brand" href="/">
                    <img src="/images/logo-dark.png.png" alt="Library" class="brand-logo-always-light" style="height: 65px; width: auto; object-fit: contain;">
                    <img src="/images/logo-white.png.png" alt="Library" class="brand-logo-always-dark" style="height: 65px; width: auto; object-fit: contain;">
                    <span class="font-heading fw-bold fs-3" style="margin-left: -5px;">Library</span>
                </a>

                <div class="d-flex align-items-center gap-2 ms-auto ms-lg-0 order-lg-last">
                    <!-- Light / Dark Mode Toggle Button (Icon Only) -->
                    <button class="theme-toggle-btn px-2.5" id="themeToggle" type="button" title="Toggle Light / Dark Mode" aria-label="Toggle Theme">
                        <i class="bi bi-moon-stars-fill fs-6" id="themeIcon"></i>
                    </button>

                    <% if (isLoggedIn) { %>
                        <a class="btn btn-sm btn-outline-light px-3 py-1 border-opacity-25 ms-1" href="/Profile">
                            <i class="bi bi-person-circle me-1"></i> Profile
                        </a>
                        <a class="btn btn-sm btn-outline-light px-3 py-1 border-opacity-25 ms-1" href="/Logout">
                            <i class="bi bi-power me-1"></i> Logout
                        </a>
                    <% } %>
                </div>

                <% if (isLoggedIn) { %>
                    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto align-items-center gap-1">
                            <li class="nav-item">
                                <a class="nav-link" href="/Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Books/Index">
                                    <i class="bi bi-book me-1"></i> Books
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Newspaper/Index">
                                    <i class="bi bi-newspaper me-1"></i> Newspapers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Magazine/Index">
                                    <i class="bi bi-journal-album me-1"></i> Magazines
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Student/Index">
                                    <i class="bi bi-people me-1"></i> Students
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Librarian/Index">
                                    <i class="bi bi-person-badge me-1"></i> Librarians
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/About">
                                    <i class="bi bi-info-circle me-1"></i> About Us
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Contact">
                                    <i class="bi bi-envelope me-1"></i> Contact Us
                                </a>
                            </li>
                        </ul>
                    </div>
                <% } %>
            </div>
        </nav>

        <!-- GLOBAL COMMAND PALETTE MODAL (Ctrl + K) -->
        <div class="modal fade" id="cmdPaletteModal" tabindex="-1" aria-labelledby="cmdPaletteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content custom-card border-0 shadow-lg">
                    <div class="modal-body p-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <i class="bi bi-search text-primary fs-4"></i>
                            <input type="text" id="cmdSearchInput" class="form-control form-control-lg border-0 shadow-none" placeholder="Search modules, books, or system shortcuts..." autofocus />
                        </div>
                        <div class="border-top pt-3">
                            <div class="text-uppercase font-monospace text-muted small mb-2 fw-semibold">Quick Navigation</div>
                            <div class="list-group list-group-flush">
                                <a href="/Dashboard" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center justify-content-between py-2.5">
                                    <span><i class="bi bi-speedometer2 me-2 text-primary"></i> Main Dashboard</span>
                                    <span class="badge bg-secondary font-monospace">/Dashboard</span>
                                </a>
                                <a href="/Books/Index" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center justify-content-between py-2.5">
                                    <span><i class="bi bi-book me-2 text-warning"></i> Books Catalog</span>
                                    <span class="badge bg-secondary font-monospace">/Books</span>
                                </a>
                                <a href="/Newspaper/Index" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center justify-content-between py-2.5">
                                    <span><i class="bi bi-newspaper me-2 text-success"></i> Daily Newspapers</span>
                                    <span class="badge bg-secondary font-monospace">/Newspaper</span>
                                </a>
                                <a href="/Magazine/Index" class="list-group-item list-group-item-action border-0 rounded-3 d-flex align-items-center justify-content-between py-2.5">
                                    <span><i class="bi bi-journal-album me-2 text-info"></i> Magazines &amp; Serials</span>
                                    <span class="badge bg-secondary font-monospace">/Magazine</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <main class="flex-grow-1 py-4">
        <div class="container-fluid px-4">
