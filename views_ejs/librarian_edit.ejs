<%- include('header') %>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="custom-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 bg-slate-900 text-white border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 bg-amber-500 bg-opacity-20 text-amber-400 rounded-3">
                            <i class="bi bi-pencil-square fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Edit Librarian Record</h4>
                            <p class="text-slate-400 small mb-0">Update profile details for Staff Member #<%= librarian.librarianId %></p>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <form action="/Librarian/Edit/<%= librarian.librarianId %>" method="post">
                        <input type="hidden" name="librarianId" value="<%= librarian.librarianId %>" />
                        <div class="mb-3">
                            <label for="Name" class="form-label fw-semibold text-slate-700">Librarian Name</label>
                            <input id="Name" name="name" class="form-control py-2" value="<%= librarian.name %>" required />
                        </div>
                        <div class="mb-3">
                            <label for="Age" class="form-label fw-semibold text-slate-700">Age</label>
                            <input id="Age" name="age" type="number" class="form-control py-2" value="<%= librarian.age %>" required />
                        </div>
                        <div class="mb-4">
                            <label for="Phone" class="form-label fw-semibold text-slate-700">Phone Number</label>
                            <input id="Phone" name="phone" class="form-control py-2" value="<%= librarian.phone %>" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-save me-1"></i> Update Librarian
                            </button>
                            <a href="/Librarian/Index" class="btn btn-secondary-custom px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
