<%- include('header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 font-heading font-heading">Students Directory</h2>
        <p class="text-muted small mb-0">Manage registered student library members, edit details, or create new student records.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('studentsTable', 'students_directory.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Student/Create" class="btn btn-primary-custom">
            <i class="bi bi-person-plus me-1"></i> Add New Student
        </a>
    </div>
</div>

<!-- Search Interface Block -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-12 col-md-8">
    </div>
    <div class="col-12 col-md-4">
        <form method="get" action="/Student/Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-card border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="<%= searchTerm %>" class="form-control border-start-0 py-2" placeholder="Search by name, email, phone..." />
            </div>
            <button type="submit" class="btn btn-primary-custom">Search</button>
            <% if (searchTerm) { %>
                <a href="/Student/Index" class="btn btn-secondary-custom d-flex align-items-center">Clear</a>
            <% } %>
        </form>
    </div>
</div>

<div class="custom-card p-0 overflow-hidden mx-auto" style="border-radius: 12px; width: max-content; max-width: 100%;">
    <table class="table align-middle border-0" style="background: transparent !important; --bs-table-bg: transparent; --bs-table-color: var(--text-primary);" id="studentsTable">
        <thead style="background: transparent; border-bottom: 1px solid var(--border-color);"><tr>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">StudentID</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">StudentName</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Email</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Phone</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (students.length > 0) { %>
                <% students.forEach(function(item) { %>
                    <tr>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="font-monospace fw-bold text-primary">#<%= item.studentId %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <div class="fw-bold"><%= item.studentName %></div>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span><%= item.email %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <code class="px-2.5 py-1 rounded font-monospace text-nowrap"><%= item.phone %></code>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a href="/Student/Edit/<%= item.studentId %>" class="btn btn-action-custom btn-blue-edit">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>
                                <a href="/Student/Delete/<%= item.studentId %>" class="btn btn-action-custom btn-blue-delete" onclick="return confirm('Are you sure you want to delete this student?')">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center text-muted">No student records found matching the criteria.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
                </div>
                </div>

<%- include('footer') %>
