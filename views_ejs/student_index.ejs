<%- include('header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 font-heading">Students Directory</h2>
        <p class="text-muted small mb-0">Manage registered student library members, edit details, or create new student records.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('studentsTable', 'students_directory.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Student/Create" class="btn btn-primary-custom">
            <i class="bi bi-person-plus me-1"></i> Add New Student
        </a>
    </div>
</div>

<div class="custom-table-container">
    <table class="custom-table" id="studentsTable">
        <thead>
            <tr>
                <th>StudentID</th>
                <th>StudentName</th>
                <th>Email</th>
                <th>Phone</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% students.forEach(function(item) { %>
                <tr>
                    <td>
                        <span class="font-monospace fw-bold text-primary">#<%= item.studentId %></span>
                    </td>
                    <td>
                        <div class="fw-bold"><%= item.studentName %></div>
                    </td>
                    <td>
                        <span><%= item.email %></span>
                    </td>
                    <td>
                        <code class="px-2.5 py-1 rounded font-monospace text-nowrap"><%= item.phone %></code>
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <a href="/Student/Edit/<%= item.studentId %>" class="btn btn-action-custom btn-blue-edit">
                                <i class="bi bi-pencil-fill"></i> Edit
                            </a>
                            <a href="/Student/Delete/<%= item.studentId %>" class="btn btn-action-custom btn-blue-delete" onclick="return confirm('Are you sure you want to delete this student?')">
                                <i class="bi bi-trash-fill"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>

<%- include('footer') %>
