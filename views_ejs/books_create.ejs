<%- include('header') %>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="custom-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 bg-slate-900 text-white border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 bg-blue-600 bg-opacity-20 text-blue-400 rounded-3">
                            <i class="bi bi-journal-plus fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Add New Book</h4>
                            <p class="text-slate-400 small mb-0">Register a new publication to the library catalog.</p>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <form action="/Books/Create" method="post">
                        <div class="mb-3">
                            <label for="title" class="form-label fw-semibold text-slate-700">Book Title</label>
                            <input id="title" name="title" class="form-control py-2" placeholder="Enter book title" autofocus required />
                        </div>
                        <div class="mb-3">
                            <label for="author" class="form-label fw-semibold text-slate-700">Author Name</label>
                            <input id="author" name="author" class="form-control py-2" placeholder="Enter author's full name" required />
                        </div>
                        <div class="mb-3">
                            <label for="isbn" class="form-label fw-semibold text-slate-700">ISBN Code</label>
                            <input id="isbn" name="isbn" class="form-control py-2 font-monospace" placeholder="e.g., 978-1234567890" required pattern="^\d{3}-\d{10}$" title="Format: XXX-XXXXXXXXXX" />
                            <div class="form-text small text-muted">Format must be 3 digits, hyphen, 10 digits (e.g., 978-0201616224).</div>
                        </div>
                        <div class="mb-4">
                            <label for="publishedDate" class="form-label fw-semibold text-slate-700">Published Date</label>
                            <input id="publishedDate" name="publishedDate" class="form-control py-2" type="date" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-plus-circle me-1"></i> Add Book
                            </button>
                            <a href="/Books/Index" class="btn btn-secondary-custom px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
