<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--bg-card); color: var(--text-primary); border-left: 4px solid var(--btn-primary-bg) !important;">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 font-heading font-heading">Newspapers Section</h2>
        <p class="text-muted small mb-0">Daily periodicals, regional news publications, and subscription pricing in ₹ (INR).</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('newspapersTable', 'newspapers_catalog.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Newspaper/Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-circle me-1"></i> Register New Newspaper
        </a>
    </div>
</div>

<!-- CATEGORY FILTER TABS & SEARCH BAR -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-12 col-md-8">
        <div class="filter-tab-bar d-flex flex-wrap gap-2">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab active" onclick="filterNewspapers('all', this)">All Categories</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterNewspapers('National', this)">National</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterNewspapers('General', this)">General News</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterNewspapers('Business', this)">Business &amp; Economy</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterNewspapers('Regional', this)">Regional News</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterNewspapers('Finance', this)">Finance &amp; Markets</button>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <form method="get" action="/Newspaper/Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-card border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchQuery" value="<%= searchQuery %>" class="form-control border-start-0 py-2" placeholder="Search title, publisher, category..." />
            </div>
            <button type="submit" class="btn btn-primary-custom">Search</button>
            <% if (searchQuery) { %>
                <a href="/Newspaper/Index" class="btn btn-secondary-custom d-flex align-items-center">Clear</a>
            <% } %>
        </form>
    </div>
</div>

<div class="custom-card p-0 overflow-hidden" style="border-radius: 12px;">
    <table class="table align-middle border-0" style="background: transparent !important; --bs-table-bg: transparent; --bs-table-color: var(--text-primary);" id="newspapersTable">
        <thead style="background: transparent; border-bottom: 1px solid var(--border-color);"><tr>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Title</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Publisher</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Language</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Category</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Daily Price (₹)</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Subscription</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Publish Date</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (newspapers.length > 0) { %>
                <% newspapers.forEach(function(item) { %>
                    <tr>
                        <td class="py-3 px-4 border-bottom border-light">
                            <div class="fw-bold"><%= item.title %></div>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span><%= item.publisher %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="text-secondary small font-monospace"><%= item.language || 'English' %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="text-secondary small"><%= item.category || item.Category || 'General News' %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="price-tag">₹<%= item.dailyPrice %>/day</span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="badge bg-secondary bg-opacity-20 text-secondary border border-secondary border-opacity-20 font-monospace" style="font-size: 0.8rem;"><%= item.subscriptionType %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="text-muted small"><%= item.publishDate %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a href="/Newspaper/Edit/<%= item.newspaperId %>" class="btn btn-action-custom btn-blue-edit">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>
                                <a href="/Newspaper/Delete/<%= item.newspaperId %>" class="btn btn-action-custom btn-blue-delete" onclick="return confirm('Are you sure you want to delete this newspaper?')">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="8" class="text-center text-muted">No newspaper records found matching the criteria.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    function filterNewspapers(category, btn) {
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        const rows = document.querySelectorAll('#newspapersTable tbody tr');
        rows.forEach(row => {
            const catCell = row.cells[3] ? row.cells[3].textContent.toLowerCase() : '';
            if (category === 'all' || catCell.includes(category.toLowerCase())) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>

<%- include('footer') %>
