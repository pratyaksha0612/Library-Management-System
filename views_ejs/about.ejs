<%- include('header') %>

<div class="container-fluid px-4 py-5" style="max-width: 1200px; margin: 0 auto;">
    <div class="pb-3 mb-5 border-bottom text-center" style="border-color: var(--border-color) !important;">
        <h2 class="fw-bold mb-2 font-heading">About Kitaab Library</h2>
        <p class="text-secondary fs-6 mb-0">Empowering academic excellence and digital resource management.</p>
    </div>

    <!-- HERO BANNER -->
    <div class="row align-items-center g-5 mb-5 pb-4">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold mb-4 font-heading" style="line-height: 1.2;">Pioneering Knowledge<br>Preservation &amp; Access</h1>
            <p class="text-secondary lead fs-6 mb-4 lh-lg">
                Kitaab Library integrates Indian literature, global technical publications, daily periodicals, and national newspapers into a unified, high-performance ecosystem designed for the modern academic institution.
            </p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a href="/Books/Index" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-book me-2"></i> Explore Catalog
                </a>
                <a href="/Contact" class="btn btn-secondary-custom px-4 py-2">
                    <i class="bi bi-envelope me-2"></i> Contact Desk
                </a>
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <div class="login-illustration-container mx-auto" style="max-width: 450px;">
                <img src="/images/graphic-dark.png" alt="Kitaab Library Illustration" class="hero-graphic-light img-fluid" style="border-radius: 16px;">
                <img src="/images/graphic-light.png" alt="Kitaab Library Illustration" class="hero-graphic-dark img-fluid" style="border-radius: 16px;">
            </div>
        </div>
    </div>

    <!-- MISSION, VISION, & VALUES CARDS -->
    <div class="row g-4 mb-5 mt-3">
        <div class="col-md-4">
            <div class="custom-card p-4 h-100 border-0" style="background: var(--bg-card); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                <div class="mb-3">
                    <i class="bi bi-compass fs-2" style="color: var(--btn-primary-bg);"></i>
                </div>
                <h4 class="fw-bold mb-3 font-heading">Our Mission</h4>
                <p class="text-secondary small mb-0 lh-lg">
                    To provide seamless, digitized access to physical literature, daily news publications, and academic resources for students, researchers, and faculty.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="custom-card p-4 h-100 border-0" style="background: var(--bg-card); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                <div class="mb-3">
                    <i class="bi bi-eye fs-2" style="color: #5BAF7A;"></i>
                </div>
                <h4 class="fw-bold mb-3 font-heading">Our Vision</h4>
                <p class="text-secondary small mb-0 lh-lg">
                    To build an intelligent, transparent library environment with minimal administrative friction, real-time metrics, and instant borrowing services.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="custom-card p-4 h-100 border-0" style="background: var(--bg-card); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
                <div class="mb-3">
                    <i class="bi bi-shield-check fs-2" style="color: #D9A441;"></i>
                </div>
                <h4 class="fw-bold mb-3 font-heading">Core Values</h4>
                <p class="text-secondary small mb-0 lh-lg">
                    Data integrity, financial transparency, operational reliability, and an unwavering commitment to user privacy protection.
                </p>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
