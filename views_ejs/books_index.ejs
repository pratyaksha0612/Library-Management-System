<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--bg-card); color: var(--text-primary); border-left: 4px solid var(--btn-primary-bg) !important;">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="container-fluid px-4 py-2">
    <!-- Header Title & Quick Actions -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
        <div>
            <h2 class="fw-bold mb-1 font-special">Books Showcase Directory</h2>
            <p class="text-muted small mb-0">Browse interactive book collection in ₹ (INR). Clean full-bleed covers with instant quick actions.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-secondary-custom" data-bs-toggle="modal" data-bs-target="#fineCalculatorModal">
                <i class="bi bi-calculator me-1 text-warning"></i> Overdue Fine Calculator (₹)
            </button>
            <button type="button" onclick="exportBooksToCSV()" class="btn btn-sm btn-secondary-custom">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
            </button>
            <a href="/Books/Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle me-1"></i> Add New Book
            </a>
        </div>
    </div>

    <!-- FILTER TABS & SEARCH BAR -->
    <div class="row g-3 align-items-center mb-4">
        <div class="col-12 col-md-7">
            <div class="filter-tab-bar d-flex flex-wrap gap-2">
                <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab active" onclick="filterBooksGrid('all', this)">All Books</button>
                <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterBooksGrid('available', this)">Available</button>
                <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterBooksGrid('borrowed', this)">Borrowed</button>
                <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterBooksGrid('under500', this)">Under ₹500</button>
                <button class="btn btn-outline-secondary rounded-pill px-3 filter-tab" onclick="filterBooksGrid('over500', this)">Over ₹500</button>
            </div>
        </div>
        <div class="col-12 col-md-5">
            <form method="get" action="/Books/Index" class="d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-card border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchQuery" value="<%= searchQuery %>" class="form-control border-start-0 py-2" placeholder="Search book title, author, or ISBN..." />
                </div>
                <button type="submit" class="btn btn-primary-custom">Search</button>
                <% if (searchQuery) { %>
                    <a href="/Books/Index" class="btn btn-secondary-custom d-flex align-items-center">Clear</a>
                <% } %>
            </form>
        </div>
    </div>

    <!-- 3 TO 4 COLUMN BOOK CARD GRID - 100% FULLY VISIBLE COVER ARTWORK -->
    <div class="row g-4" id="booksGrid">
        <% books.forEach(function(book) { %>
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 book-item-col" 
                 data-title="<%= book.title.toLowerCase() %>" 
                 data-author="<%= book.author.toLowerCase() %>" 
                 data-isbn="<%= book.isbn %>" 
                 data-price="<%= book.price %>" 
                 data-available="<%= book.isAvailable %>">
                 
                <div class="book-card-vertical">
                    <!-- FULL-BLEED COVER FRAME -->
                    <div class="book-cover-frame text-center" style="position: relative;">
                        <img src="<%= book.coverImage || 'https://via.placeholder.com/300x400/2E6F57/ffffff?text=Book+Cover' %>" 
                             alt="<%= book.title %> Cover" class="img-fluid rounded shadow-sm"
                             style="max-height: 320px; object-fit: contain; <%= !book.isAvailable ? 'filter: grayscale(100%); opacity: 0.7;' : '' %>"
                             onerror="this.src='https://via.placeholder.com/300x400/2E6F57/ffffff?text=Book+Cover'" />
                        <% if (!book.isAvailable) { %>
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-10deg); background: rgba(0,0,0,0.85); color: #fff; padding: 10px 0; font-weight: 800; border: 2px solid #fff; border-radius: 4px; width: 90%; text-align: center; letter-spacing: 2px; box-shadow: 0 4px 10px rgba(0,0,0,0.5);">OUT OF STOCK</div>
                        <% } %>
                    </div>

                    <!-- CARD CONTENT DETAILS -->
                    <div class="book-card-content">
                        <div>
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <h5 class="book-title-heading" onclick="openBookModal(<%= JSON.stringify(book) %>)"><%= book.title %></h5>
                                <% if (book.isAvailable) { %>
                                    <span class="badge-custom badge-available px-2 py-0.5" style="font-size: 0.7rem;">
                                        <i class="bi bi-check-circle-fill"></i> Available
                                    </span>
                                <% } else { %>
                                    <span class="badge-custom badge-borrowed px-2 py-0.5" style="font-size: 0.7rem;">
                                        <i class="bi bi-bookmark-fill"></i> Borrowed
                                    </span>
                                <% } %>
                            </div>
                            <div class="book-author-sub mb-2">by <%= book.author %></div>
                            
                            <!-- Little bit of context -->
                            <p class="text-secondary small mb-3 text-truncate-2" style="font-size: 0.82rem; min-height: 38px; line-height: 1.4;">
                                <%= book.description || 'No additional description details available for this library catalog item.' %>
                            </p>
                        </div>

                        <div>
                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                <code class="text-muted" style="font-size: 0.75rem;"><%= book.isbn %></code>
                                <span class="price-tag" style="font-size: 0.95rem;">₹<%= book.price %></span>
                            </div>

                            <!-- Non-bulky subtle buttons -->
                            <div class="mt-3 d-flex gap-2 justify-content-between align-items-center flex-wrap">
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-action-subtle btn-subtle-view" onclick="openBookModal(<%= JSON.stringify(book) %>)" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a href="/Books/Edit/<%= book.bookId %>" class="btn btn-action-subtle btn-subtle-edit" title="Edit Book">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="/Books/Delete/<%= book.bookId %>" class="btn btn-action-subtle btn-subtle-delete" title="Delete Book">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                                
                                <% if (book.isAvailable) { %>
                                    <a href="/Borrow/Create?bookId=<%= book.bookId %>" class="btn btn-action-subtle btn-subtle-borrow">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Borrow
                                    </a>
                                <% } else if (book.activeBorrowRecordId) { %>
                                    <a href="/Borrow/Return?borrowRecordId=<%= book.activeBorrowRecordId %>" class="btn btn-action-subtle btn-subtle-return">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Return
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        <% }); %>
    </div>

    <!-- Pagination Controls -->
    <!-- Pagination removed per new requirements -->
</div>

<!-- CLICKABLE BOOK DETAILS MODAL -->
<div class="modal fade" id="bookDetailsModal" tabindex="-1" aria-labelledby="bookDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content custom-card border-0 shadow-lg">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold font-heading d-flex align-items-center gap-2" id="bookDetailsModalLabel">
                    <i class="bi bi-journal-bookmark-fill text-primary"></i> Book Specification Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBookBody">
                <!-- Dynamically populated via JS -->
            </div>
        </div>
    </div>
</div>

<!-- OVERDUE FINE CALCULATOR MODAL -->
<div class="modal fade" id="fineCalculatorModal" tabindex="-1" aria-labelledby="fineCalculatorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-card border-0 shadow-lg">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold font-heading d-flex align-items-center gap-2" id="fineCalculatorModalLabel">
                    <i class="bi bi-calculator text-warning"></i> Overdue Fine Estimator (₹ INR)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label for="daysOverdue" class="form-label fw-semibold">Days Overdue</label>
                    <input type="number" id="daysOverdue" class="form-control py-2" placeholder="e.g. 5" value="3" min="0" oninput="calculateFine()" />
                </div>
                <div class="mb-4">
                    <label for="dailyFineRate" class="form-label fw-semibold">Daily Fine Rate (₹ INR / day)</label>
                    <input type="number" id="dailyFineRate" class="form-control py-2" value="10" readonly />
                </div>

                <div class="p-3 rounded-3 border bg-body-tertiary">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small">Base Rate per Day:</span>
                        <span class="font-monospace fw-bold">₹10</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small">Days Overdue:</span>
                        <span class="font-monospace fw-bold" id="daysDisplay">3</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total Estimated Fine:</span>
                        <span class="fs-5 font-monospace fw-bold text-danger" id="totalFineDisplay">₹30</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openBookModal(book) {
        const modalBody = document.getElementById('modalBookBody');
        const isAvailable = book.isAvailable;
        
        modalBody.innerHTML = `
            <div class="row g-4 align-items-center">
                <div class="col-12 col-md-5 text-center">
                    <img src="${book.coverImage || 'https://covers.openlibrary.org/b/isbn/' + book.isbn.replace(/-/g,'') + '-M.jpg'}" 
                         alt="${book.title}" 
                         class="img-fluid rounded-3 shadow-lg" 
                         style="max-height: 320px; object-fit: contain;" />
                </div>
                <div class="col-12 col-md-7">
                    <div class="mb-3">
                        <span class="badge ${isAvailable ? 'badge-available' : 'badge-borrowed'} mb-2">
                            <i class="bi ${isAvailable ? 'bi-check-circle-fill' : 'bi-bookmark-fill'} me-1"></i>
                            ${isAvailable ? 'Available for Borrowing' : 'Currently Checked Out'}
                        </span>
                        <h3 class="fw-bold font-heading mb-1">${book.title}</h3>
                        <p class="text-secondary lead fs-6 mb-2">Author: <strong>${book.author}</strong></p>
                    </div>

                    <div class="p-3 rounded-3 bg-body-tertiary border mb-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-muted small">ISBN Code:</div>
                                <code class="fs-6">${book.isbn}</code>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Price tag:</div>
                                <div class="price-tag fs-5">₹${book.price}</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Published Date:</div>
                                <div class="fw-semibold small">${book.publishedDate}</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small">Book ID:</div>
                                <div class="font-monospace fw-bold">#${book.bookId}</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        ${isAvailable ? `
                            <a href="/Borrow/Create?bookId=${book.bookId}" class="btn btn-primary-custom px-4">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Borrow Book Now
                            </a>
                        ` : `
                            ${book.activeBorrowRecordId ? `
                                <a href="/Borrow/Return?borrowRecordId=${book.activeBorrowRecordId}" class="btn btn-success px-4">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Return Book
                                </a>
                            ` : '<span class="text-muted fst-italic">Book is currently checked out</span>'}
                        `}
                        <a href="/Books/Edit/${book.bookId}" class="btn btn-secondary-custom">
                            <i class="bi bi-pencil-fill me-1"></i> Edit Record
                        </a>
                    </div>
                </div>
            </div>
        `;
        
        const modal = new bootstrap.Modal(document.getElementById('bookDetailsModal'));
        modal.show();
    }

    function calculateFine() {
        const days = parseInt(document.getElementById('daysOverdue').value) || 0;
        const rate = parseFloat(document.getElementById('dailyFineRate').value) || 10;
        document.getElementById('daysDisplay').textContent = days;
        document.getElementById('totalFineDisplay').textContent = `₹${days * rate}`;
    }

    function filterBooksGrid(category, btn) {
        document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        if (btn) btn.classList.add('active');

        const cols = document.querySelectorAll('.book-item-col');
        cols.forEach(col => {
            const price = parseFloat(col.getAttribute('data-price'));
            const isAvailable = col.getAttribute('data-available') === 'true';

            if (category === 'all') {
                col.style.display = '';
            } else if (category === 'available' && isAvailable) {
                col.style.display = '';
            } else if (category === 'borrowed' && !isAvailable) {
                col.style.display = '';
            } else if (category === 'under500' && price < 500) {
                col.style.display = '';
            } else if (category === 'over500' && price >= 500) {
                col.style.display = '';
            } else {
                col.style.display = 'none';
            }
        });
    }

    function searchBooksGrid() {
        const query = document.getElementById('bookSearchInput').value.toLowerCase().trim();
        const cols = document.querySelectorAll('.book-item-col');
        
        cols.forEach(col => {
            const title = col.getAttribute('data-title');
            const author = col.getAttribute('data-author');
            const isbn = col.getAttribute('data-isbn');

            if (title.includes(query) || author.includes(query) || isbn.includes(query)) {
                col.style.display = '';
            } else {
                col.style.display = 'none';
            }
        });
    }

    function exportBooksToCSV() {
        let csv = ["Title,Author,ISBN,Price(₹),Available"];
        document.querySelectorAll('.book-item-col').forEach(col => {
            const title = '"' + col.querySelector('.book-title-heading').innerText.replace(/"/g, '""') + '"';
            const author = '"' + col.querySelector('.book-author-sub').innerText.replace('by ', '').replace(/"/g, '""') + '"';
            const isbn = '"' + col.getAttribute('data-isbn') + '"';
            const price = col.getAttribute('data-price');
            const available = col.getAttribute('data-available');
            csv.push([title, author, isbn, price, available].join(','));
        });
        
        let a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([csv.join('\n')], { type: 'text/csv' }));
        a.setAttribute('download', 'books_catalog.csv');
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>

<%- include('footer') %>
