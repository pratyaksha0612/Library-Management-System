<%- include('header') %>

<div class="container-fluid px-4 py-5" style="max-width: 1000px; margin: 0 auto;">
    <% if (flashMessage) { %>
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--bg-card); color: var(--text-primary); border-left: 4px solid var(--btn-primary-bg) !important;">
            <i class="bi bi-info-circle-fill me-2" style="color: var(--btn-primary-bg);"></i> <%- flashMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="row g-5">
        <!-- Profile Side Panel -->
        <div class="col-12 col-md-4">
            <div class="custom-card p-4 text-center h-100">
                <div class="position-relative d-inline-block mb-3">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=04110b&color=ffffff&size=150" alt="Profile Avatar" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; border: 4px solid var(--border-color);">
                    <button class="btn btn-sm btn-light rounded-circle position-absolute bottom-0 end-0 shadow-sm" style="width: 32px; height: 32px; padding: 0;">
                        <i class="bi bi-camera-fill text-secondary"></i>
                    </button>
                </div>
                <h4 class="font-heading fw-bold mb-1"><%= user.name %></h4>
                <p class="text-secondary small mb-3"><%= user.role || 'Member' %></p>
                <hr style="border-color: var(--border-color);">
                <div class="d-flex justify-content-between text-secondary small mb-2">
                    <span>Member Since</span>
                    <span class="fw-semibold">August 2023</span>
                </div>
                <div class="d-flex justify-content-between text-secondary small">
                    <span>Books Read</span>
                    <span class="fw-semibold">12</span>
                </div>
            </div>
        </div>

        <!-- Profile Settings & Favorites -->
        <div class="col-12 col-md-8">
            <div class="custom-card p-4 mb-4">
                <h4 class="font-heading fw-bold mb-4 border-bottom pb-2" style="border-color: var(--border-color) !important;">Account Details</h4>
                <form action="/Profile/Update" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-semibold">Full Name</label>
                            <input type="text" class="form-control" name="name" value="<%= user.name %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary small fw-semibold">Email Address</label>
                            <input type="email" class="form-control" name="email" value="<%= user.email || user.username + '@student.in' %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-secondary small fw-semibold">Username (Read Only)</label>
                            <input type="text" class="form-control text-muted" value="<%= user.username %>" readonly>
                        </div>
                        <div class="col-12 mt-4 text-end">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">Save Changes</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="custom-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                    <h4 class="font-heading fw-bold mb-0">Favorite Genres & Books</h4>
                    <button type="button" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</button>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge rounded-pill px-3 py-2 border" style="background: var(--bg-card); color: var(--text-primary);">Fantasy</span>
                    <span class="badge rounded-pill px-3 py-2 border" style="background: var(--bg-card); color: var(--text-primary);">Science Fiction</span>
                    <span class="badge rounded-pill px-3 py-2 border" style="background: var(--bg-card); color: var(--text-primary);">Historical Fiction</span>
                    <span class="badge rounded-pill px-3 py-2 border" style="background: var(--bg-card); color: var(--text-primary);">Biography</span>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-3 p-2 border rounded-3" style="border-color: var(--border-color) !important;">
                            <img src="https://covers.openlibrary.org/b/isbn/9780747532699-S.jpg" class="rounded" style="width: 40px; height: 60px; object-fit: cover;">
                            <div>
                                <h6 class="mb-0 fw-semibold fs-6">Harry Potter</h6>
                                <span class="text-secondary small">J.K. Rowling</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-3 p-2 border rounded-3" style="border-color: var(--border-color) !important;">
                            <img src="https://covers.openlibrary.org/b/isbn/9780062316097-S.jpg" class="rounded" style="width: 40px; height: 60px; object-fit: cover;">
                            <div>
                                <h6 class="mb-0 fw-semibold fs-6">Sapiens</h6>
                                <span class="text-secondary small">Yuval Noah Harari</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
