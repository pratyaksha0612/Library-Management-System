<%- include('header') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 font-heading">Librarians Directory</h2>
        <p class="text-muted small mb-0">Manage library operational staff, age credentials, and staff assignments.</p>
    </div>
    <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
        <button type="button" onclick="exportTableToCSV('librariansTable', 'librarians_roster.csv')" class="btn btn-sm btn-secondary-custom">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </button>
        <a href="/Librarian/Create" class="btn btn-primary-custom">
            <i class="bi bi-person-plus me-1"></i> Add New Librarian
        </a>
    </div>
</div>

<!-- Search Interface Block -->
<div class="row g-3 align-items-center mb-4">
    <div class="col-12 col-md-8">
    </div>
    <div class="col-12 col-md-4">
        <form method="get" action="/Librarian/Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-card border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="<%= searchTerm %>" class="form-control border-start-0 py-2" placeholder="Search by name..." />
            </div>
            <button type="submit" class="btn btn-primary-custom">Search</button>
            <% if (searchTerm) { %>
                <a href="/Librarian/Index" class="btn btn-secondary-custom d-flex align-items-center">Clear</a>
            <% } %>
        </form>
    </div>
</div>

<div class="custom-card p-0 px-3 pb-3 overflow-hidden mx-auto" style="border-radius: 12px; width: max-content;">
    <table class="table align-middle border-0" style="background: transparent !important; --bs-table-bg: transparent; --bs-table-color: var(--text-primary);" id="librariansTable">
        <thead style="background: transparent; border-bottom: 1px solid var(--border-color);"><tr>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">LibrarianID</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Name</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Age</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide">Phone</th>
                <th class="py-3 px-4 border-0 text-muted small fw-bold tracking-wide text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (librarians.length > 0) { %>
                <% librarians.forEach(function(item) { %>
                    <tr>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="font-monospace fw-bold">#<%= item.librarianId %></span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <div class="fw-bold"><%= item.name %></div>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <span class="text-secondary small font-monospace"><%= item.age %> yrs</span>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light">
                            <code class="px-2.5 py-1 rounded font-monospace text-nowrap"><%= item.phone %></code>
                        </td>
                        <td class="py-3 px-4 border-bottom border-light text-end">
                            <div class="btn-group btn-group-sm gap-1">
                                <a href="/Librarian/Edit/<%= item.librarianId %>" class="btn btn-sm btn-blue-edit">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>
                                <a href="/Librarian/Delete/<%= item.librarianId %>" class="btn btn-sm btn-blue-delete" onclick="return confirm('Are you sure you want to delete this librarian?')">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center text-muted">No librarian records found matching the criteria.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
                </div>
                </div>

<%- include('footer') %>
