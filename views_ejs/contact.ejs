<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--bg-card); color: var(--text-primary); border-left: 4px solid var(--btn-primary-bg) !important;">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="pb-3 mb-4 border-bottom">
    <h2 class="fw-bold mb-1 font-heading">Contact Library Administration</h2>
    <p class="text-muted small mb-0">Get in touch with library support, submit book inquiries, or report system issues.</p>
</div>

<div class="row g-4 mb-5">
    <!-- LEFT FORM COLUMN -->
    <div class="col-12 col-lg-7">
        <div class="custom-card p-4 p-md-5 h-100">
            <h4 class="fw-bold mb-3 font-heading d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text text-primary"></i> Send Us a Message
            </h4>
            <p class="text-muted small mb-4">Fill out the form below and our administrative team will respond to your query at <strong>ipratyaksha.works@gmail.com</strong>.</p>
            
            <form action="/Contact/Submit" method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="contactName" class="form-label fw-semibold">Your Name</label>
                        <input type="text" id="contactName" name="name" class="form-control py-2" placeholder="e.g. Pratyaksha Singh" required />
                    </div>
                    <div class="col-md-6">
                        <label for="contactEmail" class="form-label fw-semibold">Email Address</label>
                        <input type="email" id="contactEmail" name="email" class="form-control py-2" placeholder="e.g. ipratyaksha.works@gmail.com" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="contactSubject" class="form-label fw-semibold">Subject / Topic</label>
                    <select id="contactSubject" name="subject" class="form-select py-2">
                        <option value="General Inquiry">General Indian &amp; Global Book Inquiry</option>
                        <option value="Borrowing Issue">Borrowing &amp; Return Help</option>
                        <option value="Newspaper Request">Newspaper &amp; Periodical Request</option>
                        <option value="Fine Waiver Appeal">Fine &amp; Late Fee Inquiry (₹ INR)</option>
                        <option value="Technical Support">Portal Technical Support</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label for="contactMessage" class="form-label fw-semibold">Message Content</label>
                    <textarea id="contactMessage" name="message" rows="4" class="form-control" placeholder="Describe your inquiry in detail..." required></textarea>
                </div>

                <button type="submit" class="btn btn-primary-custom py-2.5 px-4">
                    <i class="bi bi-send-fill me-1"></i> Submit Inquiry
                </button>
            </form>
        </div>
    </div>

    <!-- RIGHT DETAILS COLUMN WITH LOCALIZED INDIAN ADDRESS & CONTACTS -->
    <div class="col-12 col-lg-5">
        <div class="d-flex flex-column gap-4">
            
            <div class="custom-card p-4">
                <h5 class="fw-bold mb-3 font-heading d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill text-primary"></i> Central Library Desk
                </h5>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-3 text-secondary small">
                    <li class="d-flex align-items-start gap-2">
                        <i class="bi bi-building fs-5 text-primary"></i>
                        <div>
                            <strong>Knowledge &amp; Academic Complex</strong><br />
                            Library Administrative Block, Building 4<br />
                            Knowledge Park III, Greater Noida, Uttar Pradesh 201310, India
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-telephone-fill fs-5 text-primary"></i>
                        <div>
                            <strong>Phone Helpline:</strong> +91 98765 43210 / +91 (0120) 232-0199
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-2">
                        <i class="bi bi-envelope-at-fill fs-5 text-primary"></i>
                        <div>
                            <strong>Administrative Email:</strong> ipratyaksha.works@gmail.com
                        </div>
                    </li>
                </ul>
            </div>

            <div class="custom-card p-4">
                <h5 class="fw-bold mb-3 font-heading d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i> Operational Desk Hours (IST)
                </h5>
                <div class="d-flex justify-content-between text-secondary small pb-2 border-bottom">
                    <span>Monday - Friday:</span>
                    <span class="fw-semibold font-monospace">08:00 AM - 08:00 PM IST</span>
                </div>
                <div class="d-flex justify-content-between text-secondary small py-2 border-bottom">
                    <span>Saturday:</span>
                    <span class="fw-semibold font-monospace">09:00 AM - 05:00 PM IST</span>
                </div>
                <div class="d-flex justify-content-between text-secondary small pt-2">
                    <span>Sunday &amp; Gazetted Holidays:</span>
                    <span class="fw-semibold text-danger font-monospace">Closed (Digital Portal Active)</span>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('footer') %>
