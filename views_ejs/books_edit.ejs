<%- include('header') %>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="custom-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 bg-slate-900 text-white border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 bg-amber-500 bg-opacity-20 text-amber-400 rounded-3">
                            <i class="bi bi-pencil-square fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Edit Book Record</h4>
                            <p class="text-slate-400 small mb-0">Update information for Book #<%= book.bookId %></p>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <form action="/Books/Edit/<%= book.bookId %>" method="post">
                        <input type="hidden" name="bookId" value="<%= book.bookId %>" />
                        <div class="mb-3">
                            <label for="title" class="form-label fw-semibold text-slate-700">Book Title</label>
                            <input id="title" name="title" class="form-control py-2" value="<%= book.title %>" required />
                        </div>
                        <div class="mb-3">
                            <label for="author" class="form-label fw-semibold text-slate-700">Author Name</label>
                            <input id="author" name="author" class="form-control py-2" value="<%= book.author %>" required />
                        </div>
                        <div class="mb-3">
                            <label for="isbn" class="form-label fw-semibold text-slate-700">ISBN Code</label>
                            <input id="isbn" name="isbn" class="form-control py-2 font-monospace" value="<%= book.isbn %>" required pattern="^\d{3}-\d{10}$" title="Format: XXX-XXXXXXXXXX" />
                        </div>
                        <div class="mb-4">
                            <label for="publishedDate" class="form-label fw-semibold text-slate-700">Published Date</label>
                            <input id="publishedDate" name="publishedDate" class="form-control py-2" type="date" value="<%= book.publishedDate %>" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                            <a href="/Books/Index" class="btn btn-secondary-custom px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
