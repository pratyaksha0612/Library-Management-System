<%- include('header') %>

<div class="container login-wrapper">
    <div class="row justify-content-center align-items-center w-100">
        <div class="col-12 col-xl-11 col-xxl-10">
            <div class="row g-0 custom-card shadow-lg border-0 overflow-hidden">
                
                <!-- LEFT GRAPHIC SIDE (ALWAYS CRISP WHITE TEXT ON OBSIDIAN GRADIENT) -->
                <div class="col-lg-6 login-graphic-side d-flex flex-column justify-content-between">
                    <div>
                        <!-- PS LIBRARY LOGO EMBLEM -->
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="logo-emblem-svg">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 3L2 8L12 13L22 8L12 3Z" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M4 11.5V16.5C4 16.5 7 19.5 12 19.5C17 19.5 20 16.5 20 16.5V11.5" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M12 13V21" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div>
                                <span class="h3 font-heading fw-bold text-white mb-0 d-block">PS Library</span>
                                <span class="small text-warning font-monospace text-uppercase" style="letter-spacing: 0.08em; font-size: 0.72rem;">Executive Management System</span>
                            </div>
                        </div>

                        <h2 class="display-6 fw-bold text-white mb-3 font-heading">Digital Library &amp; Literature Portal</h2>
                        <p class="text-light opacity-90 lead fs-6">Unified academic portal for literature cataloging, daily newspapers, magazine subscriptions, student memberships, and fine billing in Indian Rupees (₹).</p>
                    </div>

                    <!-- MEANINGFUL DIGITAL LIBRARY VECTOR ILLUSTRATION -->
                    <div class="my-4 text-center">
                        <svg width="300" height="190" viewBox="0 0 300 190" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="30" y="150" width="240" height="12" rx="6" fill="#7c3aed" fill-opacity="0.3"/>
                            
                            <!-- Digital Screen -->
                            <rect x="65" y="35" width="170" height="115" rx="10" fill="#1e1b2e" stroke="#8b5cf6" stroke-width="2.5"/>
                            <rect x="75" y="45" width="150" height="85" rx="6" fill="#2d264a"/>
                            
                            <!-- Search Node & Lines -->
                            <circle cx="110" cy="75" r="18" fill="#7c3aed" fill-opacity="0.3" stroke="#a78bfa" stroke-width="2"/>
                            <line x1="123" y1="88" x2="135" y2="100" stroke="#a78bfa" stroke-width="3" stroke-linecap="round"/>
                            <rect x="145" y="65" width="65" height="6" rx="3" fill="#c4b5fd"/>
                            <rect x="145" y="78" width="48" height="6" rx="3" fill="#fef3c7"/>

                            <!-- Books Stack -->
                            <rect x="35" y="115" width="90" height="18" rx="4" fill="#3b82f6" stroke="#ffffff" stroke-width="1.5"/>
                            <rect x="40" y="98" width="80" height="17" rx="4" fill="#10b981" stroke="#ffffff" stroke-width="1.5"/>
                            <rect x="45" y="82" width="70" height="16" rx="4" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5"/>

                            <!-- Bookmark Ribbon -->
                            <path d="M100 82 V108 L106 102 L112 108 V82 Z" fill="#ef4444"/>

                            <!-- Ambient Sparkles -->
                            <circle cx="50" cy="40" r="4" fill="#fbbf24"/>
                            <circle cx="250" cy="30" r="3.5" fill="#a78bfa"/>
                            <circle cx="260" cy="100" r="5" fill="#34d399"/>
                        </svg>
                    </div>

                    <div class="text-light opacity-80 small text-center font-monospace">
                        Powered by PS Library Architecture &copy; 2026
                    </div>
                </div>

                <!-- RIGHT FORM SIDE -->
                <div class="col-lg-6 login-form-side">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold small mb-2">
                            <i class="bi bi-shield-lock-fill"></i> Secure Portal Sign-In
                        </div>
                        <h3 class="fw-bold mb-1 font-heading">User Authentication</h3>
                        <p class="text-muted small">Please authenticate to access the PS Library Management Portal.</p>
                    </div>

                    <% if (typeof message !== 'undefined' && message) { %>
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <!-- SOCIAL SIGN-IN BUTTONS -->
                    <div class="d-flex flex-column gap-2.5 mb-4">
                        <button type="button" class="btn-social-premium" onclick="alert('Google Sign-In ready for ipratyaksha.works@gmail.com')">
                            <svg width="18" height="18" viewBox="0 0 24 24">
                                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                            </svg>
                            Continue with Google
                        </button>

                        <button type="button" class="btn-social-premium" onclick="alert('Microsoft SSO integration ready.')">
                            <svg width="18" height="18" viewBox="0 0 23 23">
                                <path fill="#f35325" d="M1 1h10v10H1z"/>
                                <path fill="#81bc06" d="M12 1h10v10H1z"/>
                                <path fill="#05a6f0" d="M1 12h10v10H1z"/>
                                <path fill="#ffba08" d="M12 12h10v10H1z"/>
                            </svg>
                            Continue with Microsoft
                        </button>
                    </div>

                    <div class="d-flex align-items-center my-4">
                        <hr class="flex-grow-1 m-0">
                        <span class="px-3 text-muted small text-uppercase font-monospace fw-semibold" style="font-size: 0.75rem;">Or sign in with password</span>
                        <hr class="flex-grow-1 m-0">
                    </div>

                    <!-- DIRECT FORM LOGIN -->
                    <form action="/Login/Verify" method="post">
                        <div class="form-group mb-3.5">
                            <label for="username" class="form-label fw-semibold small text-uppercase font-monospace">Username or Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge fs-5"></i></span>
                                <input id="username" name="username" class="form-control" placeholder="e.g. admin or ipratyaksha.works@gmail.com" required />
                            </div>
                        </div>

                        <div class="form-group mb-3.5">
                            <label for="password" class="form-label fw-semibold small text-uppercase font-monospace">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key-fill fs-5"></i></span>
                                <input id="password" name="password" type="password" class="form-control" placeholder="Enter password" required />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check">
                                <input id="remember-me" name="remember-me" type="checkbox" class="form-check-input" checked>
                                <label for="remember-me" class="form-check-label small text-muted">Keep me signed in</label>
                            </div>
                        </div>

                        <button type="submit" name="Submit" class="btn btn-primary-custom w-100 py-3 justify-content-center" value="Submit">
                            <i class="bi bi-box-arrow-in-right fs-5 me-2"></i> Log In to PS Library
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
