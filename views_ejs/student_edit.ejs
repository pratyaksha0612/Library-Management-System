<%- include('header') %>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="custom-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 bg-slate-900 text-white border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 bg-amber-500 bg-opacity-20 text-amber-400 rounded-3">
                            <i class="bi bi-pencil-square fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Edit Student Record</h4>
                            <p class="text-slate-400 small mb-0">Update profile details for Student #<%= student.studentId %></p>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <form action="/Student/Edit/<%= student.studentId %>" method="post">
                        <input type="hidden" name="studentId" value="<%= student.studentId %>" />
                        <div class="mb-3">
                            <label for="StudentName" class="form-label fw-semibold text-slate-700">Student Name</label>
                            <input id="StudentName" name="studentName" class="form-control py-2" value="<%= student.studentName %>" required />
                        </div>
                        <div class="mb-3">
                            <label for="Email" class="form-label fw-semibold text-slate-700">Email Address</label>
                            <input id="Email" name="email" type="email" class="form-control py-2" value="<%= student.email %>" required />
                        </div>
                        <div class="mb-4">
                            <label for="Phone" class="form-label fw-semibold text-slate-700">Phone Number</label>
                            <input id="Phone" name="phone" class="form-control py-2" value="<%= student.phone %>" required />
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-save me-1"></i> Update Student
                            </button>
                            <a href="/Student/Index" class="btn btn-secondary-custom px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
