<%- include('header') %>

<% if (flashMessage) { %>
    <div class="alert alert-custom-blue alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i> <%= flashMessage %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="container-fluid px-4 py-3">
    <!-- EXECUTIVE WELCOME HERO BANNER -->
    <div class="custom-card p-4 p-lg-5 mb-4 border-0 position-relative overflow-hidden" 
         style="background: linear-gradient(135deg, #252038 0%, #171426 100%); color: #ffffff;">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white bg-opacity-10 text-white fw-semibold small mb-3 border border-white border-opacity-15">
                    <span class="pulse-dot"></span>
                    <span class="font-monospace" style="font-size: 0.8rem;">PS Library &bull; System Operational</span>
                </div>
                <h1 class="display-6 fw-bold mb-2 font-heading text-white">Welcome Back, Pratyaksha!</h1>
                <p class="text-light opacity-90 lead fs-6 mb-4" style="max-width: 650px;">
                    Real-time dashboard for literature circulation, daily periodicals, member directory management, and fine estimation in ₹ (INR).
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Books/Index" class="btn btn-primary-custom px-4 py-2.5">
                        <i class="bi bi-grid-3x3-gap-fill me-1"></i> Browse Books Showcase
                    </a>
                    <a href="/Student/Index" class="btn btn-outline-light px-4 py-2.5 rounded-3 fw-semibold">
                        <i class="bi bi-people me-1"></i> View Students Directory
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center text-lg-end d-none d-lg-block">
                <div class="logo-emblem-ps shadow-lg d-inline-flex align-items-center justify-content-center" 
                     style="width: 100px; height: 100px; font-size: 2.75rem; border-radius: 28px;">
                    PS
                </div>
            </div>
        </div>
    </div>

    <!-- METRICS STAT CARDS (6 UNCLUSTERED GRID ITEMS) -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-deep">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Students</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalStudents %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-steel">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Books Catalog</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalBooks %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-azure">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Newspapers</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalNewspapers %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M18 18h-8M18 10h-8"/></svg>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-sky">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Magazines</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalMagazines %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10M7 12h10M7 17h6"/></svg>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-steel">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Librarians</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalLibrarians %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/></svg>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4 col-xl-2">
            <div class="stat-card stat-card-deep">
                <div>
                    <h6 class="text-uppercase font-monospace fw-semibold opacity-75 mb-1" style="font-size: 0.72rem;">Active Borrowed</h6>
                    <h2 class="display-6 fw-bold mb-0 font-heading"><%= model.totalBorrowings %></h2>
                </div>
                <div class="stat-card-icon">
                    <svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
                </div>
            </div>
        </div>
    </div>

    <!-- CHARTS SECTION -->
    <div class="row g-4 mb-4">
        <!-- CIRCULATION TRENDS LINE CHART -->
        <div class="col-12 col-lg-8">
            <div class="custom-card p-4 p-lg-5 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold mb-1 font-heading d-flex align-items-center gap-2">
                            <i class="bi bi-graph-up-arrow text-primary"></i> Monthly Literature Circulation Trends
                        </h5>
                        <span class="text-muted small">Issued items vs returned items in ₹ (INR) volume</span>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary font-monospace px-3 py-2">₹ INR Analytics</span>
                </div>
                <div style="height: 310px; position: relative;">
                    <canvas id="trendsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- RESOURCE BREAKDOWN DOUGHNUT CHART -->
        <div class="col-12 col-lg-4">
            <div class="custom-card p-4 p-lg-5 h-100">
                <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
                    <h5 class="fw-bold mb-1 font-heading d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart-fill text-warning"></i> Resource Ratio
                    </h5>
                    <span class="badge bg-secondary font-monospace">Real-time</span>
                </div>
                <div style="height: 270px; position: relative;" class="d-flex align-items-center justify-content-center">
                    <canvas id="distributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- COMPACT & ELEGANT DASHBOARD WIDGETS -->
    <div class="row g-4 mb-4">
        <!-- COMPACT OVERDUE FINE ESTIMATOR -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="custom-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-1 font-heading d-flex align-items-center gap-2">
                        <i class="bi bi-calculator-fill text-warning"></i> Overdue Fine Estimator
                    </h5>
                    <p class="text-muted small mb-3">Rate: <strong>₹10 / day overdue</strong></p>

                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-6">
                            <label for="widgetDaysOverdue" class="form-label small fw-semibold mb-1">Overdue Days</label>
                            <input type="number" id="widgetDaysOverdue" class="form-control py-1.5" value="10" min="0" oninput="calculateWidgetFine()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold mb-1">Daily Base</label>
                            <div class="form-control py-1.5 font-monospace fw-bold opacity-75">₹10/day</div>
                        </div>
                    </div>
                </div>

                <div class="estimator-box-compact">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold small text-secondary">Total Calculated Fine:</span>
                        <span class="fs-4 font-monospace fw-bold text-danger" id="widgetTotalFineDisplay">₹100</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT ACTIVITY TIMELINE -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="custom-card p-4 h-100">
                <h5 class="fw-bold mb-3 font-heading d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-info"></i> Activity Timeline
                </h5>
                <div class="activity-timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="fw-bold small">Wings of Fire Issued</div>
                        <span class="text-muted" style="font-size: 0.8rem;">Checked out to Aarav Sharma (+91 98123 45678)</span>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot" style="background: #10b981;"></div>
                        <div class="fw-bold small">Panchatantra Tales Returned</div>
                        <span class="text-muted" style="font-size: 0.8rem;">Returned by Pratyaksha Singh (₹0 Fine)</span>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot" style="background: #f59e0b;"></div>
                        <div class="fw-bold small">The Hindu Daily Registered</div>
                        <span class="text-muted" style="font-size: 0.8rem;">Periodical subscription added at ₹7/day</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- COMPACT ADMINISTRATIVE DESK -->
        <div class="col-12 col-lg-4">
            <div class="custom-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-2 font-heading d-flex align-items-center gap-2">
                        <i class="bi bi-headset text-primary"></i> Administrative Desk
                    </h5>
                    
                    <div class="admin-desk-box mb-3">
                        <div class="fw-bold text-primary mb-1 small d-flex align-items-center gap-1.5">
                            <i class="bi bi-envelope-at-fill"></i> Support Contact Linked
                        </div>
                        <div class="text-secondary small font-monospace">ipratyaksha.works@gmail.com</div>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <a href="/Books/Index" class="btn btn-action-custom btn-blue-details justify-content-center py-2">
                        <i class="bi bi-grid-3x3-gap-fill me-1"></i> Books Showcase Directory &rarr;
                    </a>
                    <a href="/Student/Index" class="btn btn-action-custom btn-secondary-custom justify-content-center py-2">
                        <i class="bi bi-people-fill me-1"></i> Manage Registered Students &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const textColor = isDark ? '#e2e8f0' : '#181524';
        const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';

        // Line Chart: Circulation Trends
        const ctxTrends = document.getElementById('trendsChart').getContext('2d');
        new Chart(ctxTrends, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(model.monthlyTrends.labels) %>,
                datasets: [
                    {
                        label: 'Books Issued',
                        data: <%- JSON.stringify(model.monthlyTrends.borrowed) %>,
                        borderColor: '#8b5cf6',
                        backgroundColor: 'rgba(139, 92, 246, 0.15)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 3
                    },
                    {
                        label: 'Books Returned',
                        data: <%- JSON.stringify(model.monthlyTrends.returned) %>,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: textColor, font: { family: 'Plus Jakarta Sans', weight: '600' } } }
                },
                scales: {
                    x: { ticks: { color: textColor }, grid: { color: gridColor } },
                    y: { ticks: { color: textColor }, grid: { color: gridColor } }
                }
            }
        });

        // Doughnut Chart: Resource Distribution
        const ctxDist = document.getElementById('distributionChart').getContext('2d');
        new Chart(ctxDist, {
            type: 'doughnut',
            data: {
                labels: <%- JSON.stringify(model.distribution.labels) %>,
                datasets: [{
                    data: <%- JSON.stringify(model.distribution.data) %>,
                    backgroundColor: ['#7c3aed', '#059669', '#d97706', '#6366f1'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 11 } } }
                }
            }
        });
    });

    function calculateWidgetFine() {
        const days = parseInt(document.getElementById('widgetDaysOverdue').value) || 0;
        const rate = 10;
        document.getElementById('widgetTotalFineDisplay').textContent = `₹${days * rate}`;
    }
</script>

<%- include('footer') %>
