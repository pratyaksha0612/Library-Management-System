<%- include('header') %>

<div class="container-fluid px-4 py-3" style="max-width: 1200px; margin: 0 auto;">
    <!-- MINIMAL HERO SECTION -->
    <div class="text-center mb-4 pb-2" style="margin-top: -60px;">
        <img src="/images/logo-dark.png.png" alt="Library" class="brand-logo-light mx-auto mb-0" style="height: 320px; object-fit: contain;">
        <img src="/images/logo-white.png.png" alt="Library" class="brand-logo-dark mx-auto mb-0" style="height: 320px; object-fit: contain;">
        <% if (user && user.name) { %>
            <h1 class="display-5 fw-bold mb-0 font-heading" style="margin-top: -60px; position: relative; z-index: 2;">Welcome back, <span class="font-special" style="color: var(--text-primary); text-shadow: 0 2px 15px rgba(150, 150, 150, 0.4);"><%= user.name.split(' ')[0] %></span></h1>
        <% } %>
    </div>

    <!-- QUICK ACTIONS (Minimal) -->
    <div class="d-flex flex-wrap justify-content-center gap-4 mb-5 pb-4 border-bottom" style="border-color: var(--border-color) !important;">
        <a href="/Books/Index" class="btn btn-primary-custom px-4 py-2" style="box-shadow: 0 5px 15px rgba(27, 94, 32, 0.3);">
            <i class="bi bi-book me-2"></i> Browse Books
        </a>
        <a href="/Student/Index" class="btn btn-secondary-custom px-4 py-2" style="box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
            <i class="bi bi-people me-2"></i> Member Directory
        </a>
        <a href="/Newspaper/Index" class="btn btn-secondary-custom px-4 py-2" style="box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
            <i class="bi bi-newspaper me-2"></i> Newspapers
        </a>
        <a href="/Magazine/Index" class="btn btn-secondary-custom px-4 py-2" style="box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
            <i class="bi bi-journal-text me-2"></i> Magazines
        </a>
    </div>

    <!-- QUICK STATS ROW -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="text-center h-100 px-3 py-2">
                <i class="bi bi-book-half display-6 text-secondary mb-2"></i>
                <h3 class="fw-bold mb-1 font-heading" style="font-size: 2.5rem; letter-spacing: -1px; color: var(--text-primary);"><%= model.totalBooks %></h3>
                <p class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">Total Books</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-center h-100 px-3 py-2">
                <i class="bi bi-arrow-left-right display-6 text-secondary mb-2"></i>
                <h3 class="fw-bold mb-1 font-heading" style="font-size: 2.5rem; letter-spacing: -1px; color: var(--text-primary);"><%= model.totalBorrowings %></h3>
                <p class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">Active Borrowings</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-center h-100 px-3 py-2">
                <i class="bi bi-people-fill display-6 text-secondary mb-2"></i>
                <h3 class="fw-bold mb-1 font-heading" style="font-size: 2.5rem; letter-spacing: -1px; color: var(--text-primary);"><%= model.totalStudents %></h3>
                <p class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">Total Members</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="text-center h-100 px-3 py-2">
                <i class="bi bi-journal-check display-6 text-secondary mb-2"></i>
                <h3 class="fw-bold mb-1 font-heading" style="font-size: 2.5rem; letter-spacing: -1px; color: var(--text-primary);"><%= model.totalPublications %></h3>
                <p class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">Publications</p>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <!-- LIBRARY STATISTICS -->
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-3">
                    <h4 class="font-heading fw-bold mb-0">Library Overview</h4>
                    <span id="liveDateTime" class="badge border fw-medium px-3 py-1" style="background: var(--bg-card); color: var(--text-primary);"></span>
                </div>
                <div class="d-flex gap-4 text-secondary small fw-semibold">
                    <span>Books: <%= model.totalBooks %></span>
                    <span>Active Borrowings: <%= model.totalBorrowings %></span>
                    <span>Members: <%= model.totalStudents %></span>
                </div>
            </div>
            <div class="custom-card p-4 d-flex flex-column" style="height: 400px;">
                <div style="flex-grow: 1; position: relative; width: 100%;">
                    <canvas id="trendsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- RECENT ACTIVITY -->
        <div class="col-lg-4">
            <h4 class="font-heading fw-bold mb-4">Recent Activity</h4>
            <div class="custom-card p-4 h-100">
                <div class="d-flex flex-column gap-4 mt-2">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="p-2 rounded-circle" style="background: rgba(91, 175, 122, 0.15); color: #5BAF7A;">
                            <i class="bi bi-arrow-down-circle fs-5"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-semibold fs-6">Book Returned</p>
                            <span class="text-secondary small">Atomic Habits by Priya Sharma</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-start">
                        <div class="p-2 rounded-circle" style="background: rgba(217, 164, 65, 0.15); color: #D9A441;">
                            <i class="bi bi-arrow-up-circle fs-5"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-semibold fs-6">Book Issued</p>
                            <span class="text-secondary small">Sapiens to Arjun Reddy</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-start">
                        <div class="p-2 rounded-circle" style="background: rgba(46, 111, 87, 0.15); color: #2E6F57;">
                            <i class="bi bi-person-plus fs-5"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-semibold fs-6">New Member</p>
                            <span class="text-secondary small">Ananya Desai joined the library</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- POPULAR READS SECTION -->
    <div class="mt-5">
        <h4 class="font-heading fw-bold mb-4">Popular Reads</h4>
        <div class="row g-4">
            <% if (model.topBooks && model.topBooks.length > 0) { %>
                <% model.topBooks.forEach(book => { %>
                    <div class="col-6 col-md-3">
                        <div class="h-100 text-center" style="transition: transform 0.3s ease;">
                            <div style="position: relative; width: 100%;">
                                <img src="<%= book.coverImage || 'https://via.placeholder.com/300x450?text=No+Cover' %>" onerror="this.src='https://via.placeholder.com/300x450?text=No+Cover'" alt="<%= book.title %>" class="img-fluid rounded mb-3 shadow-sm" style="width: 100%; height: auto; aspect-ratio: 2/3; object-fit: cover;">
                            </div>
                            <h6 class="fw-bold mb-1 text-truncate"><%= book.title %></h6>
                            <p class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;"><%= book.author %></p>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p class="text-muted">No popular books found.</p>
            <% } %>
        </div>
    </div>
</div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Live Date Time Feature
        function updateDateTime() {
            const now = new Date();
            const options = { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            document.getElementById('liveDateTime').textContent = now.toLocaleDateString('en-US', options);
        }
        updateDateTime();
        setInterval(updateDateTime, 60000);

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const textColor = isDark ? '#ffffff' : '#1a1f1d';
        const gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';

        // Line Chart: Circulation Trends
        const ctxTrends = document.getElementById('trendsChart').getContext('2d');
        new Chart(ctxTrends, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(model.monthlyTrends.labels) %>,
                datasets: [
                    {
                        label: 'Books Issued',
                        data: <%- JSON.stringify(model.monthlyTrends.borrowed) %>,
                        borderColor: '#2E6F57',
                        backgroundColor: 'rgba(46, 111, 87, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointBackgroundColor: '#2E6F57',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#2E6F57'
                    },
                    {
                        label: 'Books Returned',
                        data: <%- JSON.stringify(model.monthlyTrends.returned) %>,
                        borderColor: '#5BAF7A',
                        backgroundColor: 'rgba(91, 175, 122, 0.05)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2,
                        pointBackgroundColor: '#5BAF7A',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#5BAF7A'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { 
                        position: 'bottom',
                        labels: { color: textColor, font: { family: 'Inter', weight: '500' }, padding: 20 } 
                    }
                },
                scales: {
                    x: { ticks: { color: textColor }, grid: { color: gridColor, drawBorder: false } },
                    y: { ticks: { color: textColor, stepSize: 20 }, grid: { color: gridColor, drawBorder: false }, beginAtZero: true }
                }
            }
        });
    });
</script>

<%- include('footer') %>
