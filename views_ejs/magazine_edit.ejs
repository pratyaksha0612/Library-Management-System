<%- include('header') %>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="custom-card shadow-lg border-0 overflow-hidden">
                <div class="p-4 bg-slate-900 text-white border-bottom border-slate-800">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 bg-amber-500 bg-opacity-20 text-amber-400 rounded-3">
                            <i class="bi bi-pencil-square fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Edit Magazine Record</h4>
                            <p class="text-slate-400 small mb-0">Update publication details for Magazine #<%= magazine.magazineId %></p>
                        </div>
                    </div>
                </div>

                <div class="p-4">
                    <form action="/Magazine/Edit/<%= magazine.magazineId %>" method="post">
                        <input type="hidden" name="magazineId" value="<%= magazine.magazineId %>" />
                        <div class="mb-3">
                            <label for="title" class="form-label fw-semibold">Magazine Title</label>
                            <input id="title" name="title" class="form-control py-2" value="<%= magazine.title %>" required />
                        </div>
                        <div class="mb-3">
                            <label for="publisher" class="form-label fw-semibold">Publisher</label>
                            <input id="publisher" name="publisher" class="form-control py-2" value="<%= magazine.publisher %>" required />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="issueNumber" class="form-label fw-semibold">Issue Number</label>
                                <input id="issueNumber" name="issueNumber" class="form-control py-2 font-monospace" value="<%= magazine.issueNumber %>" required />
                            </div>
                            <div class="col-md-6">
                                <label for="genre" class="form-label fw-semibold">Genre / Domain</label>
                                <input id="genre" name="genre" class="form-control py-2" value="<%= magazine.genre %>" required />
                            </div>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="price" class="form-label fw-semibold">Price (₹ INR)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input id="price" name="price" type="number" step="1" class="form-control py-2" value="<%= magazine.price %>" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="frequency" class="form-label fw-semibold">Frequency</label>
                                <select id="frequency" name="frequency" class="form-select py-2">
                                    <option value="Weekly" <%= magazine.frequency === 'Weekly' ? 'selected' : '' %>>Weekly</option>
                                    <option value="Fortnightly" <%= magazine.frequency === 'Fortnightly' ? 'selected' : '' %>>Fortnightly</option>
                                    <option value="Monthly" <%= magazine.frequency === 'Monthly' ? 'selected' : '' %>>Monthly</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-custom px-4 py-2">
                                <i class="bi bi-save me-1"></i> Update Magazine
                            </button>
                            <a href="/Magazine/Index" class="btn btn-secondary-custom px-4 py-2">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
